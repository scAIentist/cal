# cal.scaientist.eu — production env for docker compose (deploy/hetzner)
# cp .env.example .env ; never commit .env

# --- Postgres (docker service `db`) — password must be URL-safe: letters and digits only ---
POSTGRES_USER=cal
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=cal

# --- App image ---
CAL_IMAGE_TAG=latest        # or a specific sha tag from ghcr.io/scaientist/cal

# --- URLs ---
NEXT_PUBLIC_WEBAPP_URL=https://cal.scaientist.eu
NEXTAUTH_URL=https://cal.scaientist.eu

# --- Secrets ---
NEXTAUTH_SECRET=            # openssl rand -base64 32
CALENDSO_ENCRYPTION_KEY=    # openssl rand -base64 24   (exactly 32 bytes)
CRON_API_KEY=               # openssl rand -hex 16
CRON_SECRET=                # openssl rand -hex 32

# --- Signup policy: open only to company domains ---
NEXT_PUBLIC_DISABLE_SIGNUP=
SIGNUP_ALLOWED_EMAIL_DOMAINS=scaientist.eu,scaientist.com,sci.tools

# --- Google Calendar + Google Meet (OAuth client JSON from Google Cloud, pasted as ONE line) ---
GOOGLE_API_CREDENTIALS=
GOOGLE_LOGIN_ENABLED=false

# --- Email via Resend ---
EMAIL_FROM=cal@scaientist.eu
EMAIL_FROM_NAME=scAIentist
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=      # Resend API key

# --- Branding ---
NEXT_PUBLIC_APP_NAME=scAIentist Cal
NEXT_PUBLIC_COMPANY_NAME=scAIentist
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=info@scaientist.com

# --- Misc ---
CALCOM_TELEMETRY_DISABLED=1
NODE_ENV=production
