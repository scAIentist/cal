# Cal runtime configuration. Stored as the GitHub secret CAL_ENV (whole file) and written to
# /opt/stacks/cal/.env by the deploy workflow. Never commit the real file.
# Values that need generating: see docs/scaientist/DEPLOY.md

POSTGRES_USER=cal
POSTGRES_PASSWORD=          # openssl rand -hex 24 (letters/digits only)
POSTGRES_DB=cal
CAL_IMAGE_TAG=latest

NEXT_PUBLIC_WEBAPP_URL=https://cal.scaientist.eu
NEXTAUTH_URL=https://cal.scaientist.eu
NEXTAUTH_SECRET=            # openssl rand -base64 32
CALENDSO_ENCRYPTION_KEY=    # openssl rand -base64 24
CRON_API_KEY=               # openssl rand -hex 16
CRON_SECRET=                # openssl rand -hex 32

NEXT_PUBLIC_DISABLE_SIGNUP=
SIGNUP_ALLOWED_EMAIL_DOMAINS=scaientist.eu,scaientist.com,sci.tools

GOOGLE_API_CREDENTIALS=
GOOGLE_LOGIN_ENABLED=false

EMAIL_FROM=cal@scaientist.eu
EMAIL_FROM_NAME=scAIentist
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=

NEXT_PUBLIC_APP_NAME=scAIentist Cal
NEXT_PUBLIC_COMPANY_NAME=scAIentist
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=info@scaientist.com
CALCOM_TELEMETRY_DISABLED=1
NODE_ENV=production
